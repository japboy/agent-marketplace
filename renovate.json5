{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex", "github-actions", "mise", "pep621"],
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "internalChecksFilter": "strict",
  "internalChecksAsSuccess": false,
  "prCreation": "status-success",
  "rebaseWhen": "behind-base-branch",
  "timezone": "Asia/Tokyo",
  "schedule": ["* 0-3 * * 1"],
  "updateNotScheduled": true,
  "separateMajorMinor": true,
  "separateMinorPatch": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-3 * * 1"],
  },
  "packageRules": [
    {
      "description": "Wait three days before accepting PyPI releases",
      "matchDatasources": ["pypi"],
      "minimumReleaseAge": "3 days",
    },
    {
      "description": "Keep major updates under manual review",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
    },
    {
      "description": "Automerge non-major updates after CI passes",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "rollback",
        "bump",
      ],
      "automerge": true,
    },
    {
      "description": "Update dprint and the formatter plugins together",
      "matchPackageNames": [
        "dprint/dprint",
        "dprint/dprint-plugin-json",
        "dprint/dprint-plugin-markdown",
        "g-plane/pretty_yaml",
      ],
      "groupName": "dprint toolchain",
      "groupSlug": "dprint-toolchain",
    },
    {
      "description": "Keep the hk tool and Pkl declarations in sync",
      "matchPackageNames": ["jdx/hk"],
      "groupName": "hk toolchain",
      "groupSlug": "hk-toolchain",
    },
    {
      "description": "Update the CI mise action and binary together",
      "matchPackageNames": ["jdx/mise-action", "jdx/mise"],
      "groupName": "mise CI setup",
      "groupSlug": "mise-ci-setup",
    },
    {
      "description": "Update the Python and uv pins used to resolve the workspace lockfile",
      "matchPackageNames": ["python/cpython", "python", "astral-sh/uv", "uv"],
      "groupName": "Python toolchain",
      "groupSlug": "python-toolchain",
    },
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the uv version required by pyproject.toml",
      "managerFilePatterns": ["/^pyproject\\.toml$/"],
      "matchStrings": ["required-version = \"==(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "datasourceTemplate": "pypi",
      "packageNameTemplate": "uv",
      "versioningTemplate": "semver",
    },
    {
      "customType": "regex",
      "description": "Update both hk versions in the Pkl package URI",
      "managerFilePatterns": ["/^hk\\.pkl$/"],
      "matchStrings": [
        "amends \"package://github\\.com/jdx/hk/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/hk@\\d+\\.\\d+\\.\\d+#/Config\\.pkl\"",
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "jdx/hk",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "amends \"package://github.com/jdx/hk/releases/download/v{{{newValue}}}/hk@{{{newValue}}}#/Config.pkl\"",
    },
    {
      "customType": "regex",
      "description": "Update the minimum hk version",
      "managerFilePatterns": ["/^hk\\.pkl$/"],
      "matchStrings": ["min_hk_version = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "jdx/hk",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver",
    },
    {
      "customType": "regex",
      "description": "Update the dprint Markdown plugin and digest",
      "managerFilePatterns": ["/^dprint\\.json$/"],
      "matchStrings": [
        "https://plugins\\.dprint\\.dev/markdown-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.wasm@(?<currentDigest>[a-f0-9]{64})",
      ],
      "datasourceTemplate": "github-release-attachments",
      "packageNameTemplate": "dprint/dprint-plugin-markdown",
      "versioningTemplate": "semver",
    },
    {
      "customType": "regex",
      "description": "Update the dprint JSON plugin and digest",
      "managerFilePatterns": ["/^dprint\\.json$/"],
      "matchStrings": [
        "https://plugins\\.dprint\\.dev/json-(?<currentValue>\\d+\\.\\d+\\.\\d+)\\.wasm@(?<currentDigest>[a-f0-9]{64})",
      ],
      "datasourceTemplate": "github-release-attachments",
      "packageNameTemplate": "dprint/dprint-plugin-json",
      "versioningTemplate": "semver",
    },
    {
      "customType": "regex",
      "description": "Update the dprint Pretty YAML plugin and digest",
      "managerFilePatterns": ["/^dprint\\.json$/"],
      "matchStrings": [
        "https://plugins\\.dprint\\.dev/g-plane/pretty_yaml-(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\.wasm@(?<currentDigest>[a-f0-9]{64})",
      ],
      "datasourceTemplate": "github-release-attachments",
      "packageNameTemplate": "g-plane/pretty_yaml",
      "versioningTemplate": "semver",
    },
  ],
}
