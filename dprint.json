{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 100,
  "newLineKind": "lf",
  "json": {
    "associations": [
      "renovate.json5"
    ]
  },
  "markdown": {
    "textWrap": "always",
    "emphasisKind": "asterisks",
    "strongKind": "asterisks",
    "unorderedListKind": "dashes",
    "headingKind": "atx",
    "listIndentKind": "commonMark",
    "tags": {
      "markdown": "md",
      "md": "md"
    }
  },
  "includes": [
    "**/*.{md,mkd,mdwn,mkdn,mdown,markdown,json,json5,yaml,yml}"
  ],
  "excludes": [
    "**/.git",
    "**/.venv",
    "repos"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.28.2.wasm@77d0095123be1df7c802ef1b8875433c757f79238c26a58d1c49b8cafca44e2c",
    "https://plugins.dprint.dev/json-0.25.2.wasm@811ca4c6f732bcd6f707bc2f42d42395bb4127cdf829960cf628a18fc149777e",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm@40a2fdda7040317eb1b23520f3a00769a5571eedb049c4ca9175c1b9eeba01ae"
  ]
}
