{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 100,
  "newLineKind": "lf",
  "json": {
    "associations": [
      "renovate.json5"
    ]
  },
  "markdown": {
    "textWrap": "always",
    "emphasisKind": "asterisks",
    "strongKind": "asterisks",
    "unorderedListKind": "dashes",
    "headingKind": "atx",
    "listIndentKind": "commonMark",
    "tags": {
      "markdown": "md",
      "md": "md"
    }
  },
  "includes": [
    "**/*.{md,mkd,mdwn,mkdn,mdown,markdown,json,json5,yaml,yml}"
  ],
  "excludes": [
    "**/.git",
    "**/.venv",
    "repos"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.29.0.wasm@714aea7555dd9831861be466da8b26b2d92316d3cde550ef3e1f63b31f4ea302",
    "https://plugins.dprint.dev/json-0.26.0.wasm@9abcd6eb43b3d04655649090c2e7ad14948da6acfe0374cb47ccd9eb3c48903d",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm@40a2fdda7040317eb1b23520f3a00769a5571eedb049c4ca9175c1b9eeba01ae"
  ]
}
